# Normalize line endings for the whole repository.
# Text files are stored with LF in the repo and checked out as-is on Linux/macOS.
# On Windows, git will convert to CRLF on checkout if `core.autocrlf=true`,
# but the canonical version in the repo stays LF.

* text=auto eol=lf

# Explicit text files (defensive — covers cases where `text=auto` heuristic fails)
*.md         text eol=lf
*.txt        text eol=lf
*.py         text eol=lf
*.pyi        text eol=lf
*.toml       text eol=lf
*.cfg        text eol=lf
*.ini        text eol=lf
*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.sh         text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf
LICENSE      text eol=lf

# Windows-only scripts should keep CRLF
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# Binary assets — never normalize
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.ico        binary
*.svg        text eol=lf
*.pdf        binary
*.zip        binary
*.tar        binary
*.tar.gz     binary
*.tgz        binary
*.gz         binary
*.7z         binary

# Audio / video / model artifacts (none should be committed, but be defensive)
*.mp4        binary
*.mkv        binary
*.webm       binary
*.mov        binary
*.mp3        binary
*.wav        binary
*.flac       binary
*.ogg        binary
*.bin        binary
*.pt         binary
*.onnx       binary
*.safetensors binary
